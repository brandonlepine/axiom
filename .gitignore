# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
.coverage

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Secrets / local config
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/

# ---------------------------------------------------------------------------
# Large local artifacts (never committed; regenerated or downloaded)
# NOTE: .gitignore does NOT support inline (end-of-line) comments -- keep each
# pattern on its own line with comments above it, never after the pattern.
# ---------------------------------------------------------------------------
# Local model checkpoints (e.g. Llama-3.1-8B) and SAE checkpoints.
models/
saes/
# All pipeline outputs (raws, summaries, figures), organized per model/dataset.
outputs/
checkpoints/
wandb/
runs/
*.log
tmp/
temp/

# ---------------------------------------------------------------------------
# Data tracking policy
# ---------------------------------------------------------------------------
# data/cohorts/  -> the frozen pod-input cohorts: TRACKED (small, the inputs the pod reads).
# data/manifests/-> per-dataset provenance manifests: TRACKED.
# data/raw/      -> upstream sources: IGNORED (large / externally licensed; see manifests).
# data/processed/-> parsed/scored intermediates: IGNORED, EXCEPT the small, reproducible
#                   combined candidate pool the cohort builder freezes from.
# NOTE: ignore directory *contents* (/*), not the directory itself, so the carve-outs
# below can re-include specific files (git won't descend into a fully-excluded dir).
data/raw/*
data/processed/*
!data/processed/combined/
data/processed/combined/*
!data/processed/combined/bbq_crows_candidates.csv

# Legacy data dirs from the pre-migration layout (kept ignored until removed).
input_data/
intermediate_data/
test_data/
